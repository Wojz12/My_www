# ======================================
# Portfolio - Zmienne środowiskowe
# ======================================

# Skopiuj ten plik jako .env.local i uzupełnij wartości
# Komenda: copy env.example .env.local (Windows)
# lub: cp env.example .env.local (Mac/Linux)

# OpenAI API Key (dla chatbota)
# Uzyskaj klucz na: https://platform.openai.com/api-keys
# Domyślny model: gpt-6-luna (najlepszy stosunek jakości do ceny)
OPENAI_API_KEY=sk-...
# (Opcjonalne) Nadpisanie modelu chatbota
# OPENAI_MODEL=gpt-6-luna
# (Opcjonalne) Globalny dzienny limit wiadomości do chatbota (sufit kosztów), domyślnie 1000
# CHAT_GLOBAL_DAILY_LIMIT=1000
# (Opcjonalne) Dodatkowe dozwolone domeny dla /api/chat, po przecinku
# ALLOWED_ORIGINS=https://twojadomena.pl

# (Opcjonalne) Google Gemini API Key - alternatywa dla OpenAI
# GEMINI_API_KEY=AIza...

# Resend API (dla formularza kontaktowego)
# Uzyskaj klucz na: https://resend.com
RESEND_API_KEY=re_...

# Email odbiorcy formularza kontaktowego (opcjonalne)
# Domyślnie: soczynskiwojtek@gmail.com
CONTACT_EMAIL=

# n8n Webhook (dla AI Metrics - aktualizacja danych z zewnętrznych źródeł)
# Token autoryzacyjny dla endpointu /api/ai-metrics (POST)
N8N_AI_METRICS_TOKEN=
